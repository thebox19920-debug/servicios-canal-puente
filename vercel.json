{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": "web",
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/acceso-scp.html",
      "destination": "/butaina",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/butaina",
      "destination": "/butaina/index.html"
    },
    {
      "source": "/contratar",
      "destination": "/contratar.html"
    },
    {
      "source": "/pagar",
      "destination": "/pagar.html"
    }
  ],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 10
    }
  }
}
